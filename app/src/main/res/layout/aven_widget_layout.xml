<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AVEN • LIVING WORLD"
            android:textColor="#5E7864"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_environment_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_widget_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Thriving"
            android:textColor="#264E36"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_stage_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Grove Stage"
        android:textColor="#191C1A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_stat_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="82% intentional choices today"
        android:textColor="#404943"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_action_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to pause and reflect →"
        android:textColor="#3D6B4F"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
